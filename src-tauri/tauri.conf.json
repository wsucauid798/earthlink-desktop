{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "earthlink-desktop",
  "version": "0.1.0",
  "identifier": "com.wsawyerr.earthlink-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EarthLink",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu-compositing --ignore-gpu-blocklist --enable-unsafe-swiftshader",
        "dataDirectory": "webview-gpu-safe"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/default-config.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/wsucauid798/earthlink-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwNkM5MDI4MTg3NDBEQzgKUldUSURYUVlLSkJzRURRNGdRWEQrWFBoSS8xRkhnRm9INEZUMmJ3QmlPdC9RKzMrRC9FQ2MvUlgK"
    }
  }
}
